# Local development configuration. Copy to `.env` (git-ignored) and adjust.
# Every value here is a LOCAL-ONLY PLACEHOLDER. Never put real credentials in this file.
# The backend refuses to start in staging/prod if a value still contains "change-me".

ENVIRONMENT=dev
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=false

# --- PostgreSQL (docker compose) --------------------------------------------
# Superuser: used only by the container init script that provisions roles.
POSTGRES_PASSWORD=change-me-postgres-superuser
# Databases created by infra/postgres/init/01-roles.sh (comma separated, no spaces).
APP_DB_NAMES=jira,jira_test
# Role passwords (roles: app_owner = migrations, app_rw = API, app_worker = worker).
APP_OWNER_PASSWORD=change-me-app-owner
APP_RW_PASSWORD=change-me-app-rw
APP_WORKER_PASSWORD=change-me-app-worker

# Runtime API connection: MUST use the least-privileged app_rw role.
DATABASE_URL=postgresql+asyncpg://app_rw:change-me-app-rw@localhost:5432/jira
# Migration connection: app_owner. Used by Alembic only, never by the API/worker.
MIGRATION_DATABASE_URL=postgresql+asyncpg://app_owner:change-me-app-owner@localhost:5432/jira

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Tests (integration tests use a separate database) ----------------------
TEST_DATABASE_URL=postgresql+asyncpg://app_rw:change-me-app-rw@localhost:5432/jira_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://app_owner:change-me-app-owner@localhost:5432/jira_test
TEST_SUPERUSER_DATABASE_URL=postgresql+asyncpg://postgres:change-me-postgres-superuser@localhost:5432/jira_test
TEST_REDIS_URL=redis://localhost:6379/1
