# Production / hosted deploy (Render, see DEPLOYMENT.md): set these as encrypted secrets.
# Do not commit real values.
#
# Local Docker + tests: copy docs/local-dev.env to .env (see README).

ENVIRONMENT=prod
LOG_LEVEL=INFO
APP_BASE_URL=
COOKIE_SECURE=true

DATABASE_URL=
MIGRATION_DATABASE_URL=
WORKER_DATABASE_URL=
RETENTION_DATABASE_URL=
REDIS_URL=
APP_SECRET_KEY=

BREACH_CHECK_MODE=hibp
RATE_LIMIT_ENABLED=true
UVICORN_FORWARDED_ALLOW_IPS=*

SIGNUP_ENABLED=false
EMAIL_DELIVERY_ENABLED=false
