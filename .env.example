# Local development configuration. Copy to `.env` (git-ignored) and adjust.
# Every value here is a LOCAL-ONLY PLACEHOLDER. Never put real credentials in this file.
# The backend refuses to start in staging/prod if a value still contains "change-me".

ENVIRONMENT=dev
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=false

# --- Identity (M1) -------------------------------------------------------------
# Root secret for derived keys (CSRF, email HMAC, rate-limit keys). >= 32 characters.
# Production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
APP_SECRET_KEY=change-me-local-dev-secret-key-0123456789abcdef
# Signup defaults to enabled except in prod (D1: prod stays off until M2 email verification).
# SIGNUP_ENABLED=true
# Pwned Passwords k-anonymity check (free, no API key). Use local_only when offline (dev/test only).
BREACH_CHECK_MODE=hibp

# --- Email (M2) -----------------------------------------------------------------
# Off by default in the application. Here it is enabled for LOCAL development only and
# points at Mailpit (free local SMTP sink, started by `make infra-up`; UI on :8025).
# Production requires an approved provider over TLS with credentials (D13/D14).
EMAIL_DELIVERY_ENABLED=true
EMAIL_FROM=no-reply@jira.localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none

# --- PostgreSQL (docker compose) --------------------------------------------
# Superuser: used only by the container init script that provisions roles.
POSTGRES_PASSWORD=change-me-postgres-superuser
# Databases created by infra/postgres/init/01-roles.sh (comma separated, no spaces).
APP_DB_NAMES=jira,jira_test
# Role passwords (roles: app_owner = migrations, app_rw = API, app_worker = worker).
APP_OWNER_PASSWORD=change-me-app-owner
APP_RW_PASSWORD=change-me-app-rw
APP_WORKER_PASSWORD=change-me-app-worker

# Runtime API connection: MUST use the least-privileged app_rw role.
DATABASE_URL=postgresql+asyncpg://app_rw:change-me-app-rw@localhost:5432/jira
# Worker connection: MUST use the least-privileged app_worker role.
WORKER_DATABASE_URL=postgresql+asyncpg://app_worker:change-me-app-worker@localhost:5432/jira
# Migration connection: app_owner. Used by Alembic only, never by the API/worker.
MIGRATION_DATABASE_URL=postgresql+asyncpg://app_owner:change-me-app-owner@localhost:5432/jira

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Tests (integration tests use a separate database) ----------------------
TEST_DATABASE_URL=postgresql+asyncpg://app_rw:change-me-app-rw@localhost:5432/jira_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://app_owner:change-me-app-owner@localhost:5432/jira_test
TEST_SUPERUSER_DATABASE_URL=postgresql+asyncpg://postgres:change-me-postgres-superuser@localhost:5432/jira_test
TEST_WORKER_DATABASE_URL=postgresql+asyncpg://app_worker:change-me-app-worker@localhost:5432/jira_test
TEST_REDIS_URL=redis://localhost:6379/1
# Mailpit (shared with dev; tests use unique addresses and query the API by recipient).
TEST_SMTP_HOST=localhost
TEST_SMTP_PORT=1025
TEST_MAILPIT_URL=http://localhost:8025

# --- Render/Supabase production reference (see DEPLOYMENT.md) -----------------
# Same variable names as above, set as secrets in the Render dashboard, not here:
#   DATABASE_URL / WORKER_DATABASE_URL / MIGRATION_DATABASE_URL -> Supabase direct
#     connection (port 5432, not the 6543 pooler), e.g.
#     postgresql+asyncpg://app_rw:<password>@db.<project-ref>.supabase.co:5432/postgres?ssl=require
#   REDIS_URL -> a free external provider (e.g. Upstash), rediss://... (TLS)
#   APP_BASE_URL -> https://<frontend-service>.onrender.com, COOKIE_SECURE=true
#   UVICORN_FORWARDED_ALLOW_IPS=* (Render's own edge proxy; not FORWARDED_ALLOW_IPS,
#     which only exists as a docker-compose variable name for local nginx, not a
#     setting uvicorn reads)
# APP_SECRET_KEY should be generated fresh for production, never reused from here.
